# ─── Amazon Bedrock (model provider) ────────────────────────────────
# Strands uses Bedrock by default. Provide AWS credentials with permission
# to invoke the model, plus a region.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Optional: override the default Bedrock model id.
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6-20250930-v1:0

# ─── PayPal MCP (agent tools) ───────────────────────────────────────
# Sandbox app credentials. The agent mints its own short-lived MCP token
# from these at startup, so you normally don't need PAYPAL_SANDBOX_TOKEN.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Optional fallback: a pre-minted bearer token, used only if the client
# credentials above are absent. Leave blank when using client credentials.
PAYPAL_SANDBOX_TOKEN=

# ─── Server ─────────────────────────────────────────────────────────
PORT=3000
