{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "paypal-mcp-server": {
        "type": "local",
        "command": [
          "npx",
          "mcp-remote",
          "https://mcp.sandbox.paypal.com/sse",
          "--header",
          "Authorization: Bearer {env:PAYPAL_SANDBOX_TOKEN}",
          "--transport",
          "sse-only"
        ],
        "timeout": {
          "startup": 60000
        }
      }
    }
  }
}
